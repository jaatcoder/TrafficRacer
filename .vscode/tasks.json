{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "git-status-check",
			"type": "shell",
			"command": "git",
			"args": [
				"status",
				"--short"
			],
			"isBackground": false
		},
		{
			"label": "git-remote-check",
			"type": "shell",
			"command": "git",
			"args": [
				"remote",
				"-v"
			],
			"isBackground": false
		},
		{
			"label": "git-branch-check",
			"type": "shell",
			"command": "git",
			"args": [
				"branch",
				"--show-current"
			],
			"isBackground": false
		},
		{
			"label": "unity-cli-check",
			"type": "shell",
			"command": "/Applications/Unity/Hub/Editor/6000.3.9f1/Unity.app/Contents/MacOS/Unity",
			"args": [
				"-version"
			],
			"isBackground": false
		},
		{
			"label": "build-macos-app",
			"type": "shell",
			"command": "/Applications/Unity/Hub/Editor/6000.3.9f1/Unity.app/Contents/MacOS/Unity",
			"args": [
				"-batchmode",
				"-quit",
				"-projectPath",
				".",
				"-executeMethod",
				"BuildScript.BuildMacOS",
				"-logFile",
				"Builds/macos-build.log"
			],
			"isBackground": false
		},
		{
			"label": "git-status-short",
			"type": "shell",
			"command": "git",
			"args": [
				"status",
				"--short"
			]
		},
		{
			"label": "git-add-all",
			"type": "shell",
			"command": "git",
			"args": [
				"add",
				"-A"
			]
		},
		{
			"label": "git-add-build-app",
			"type": "shell",
			"command": "git",
			"args": [
				"add",
				"-f",
				"Builds/macOS/TrafficRacer.app"
			]
		},
		{
			"label": "git-status-staged",
			"type": "shell",
			"command": "git",
			"args": [
				"status",
				"--short"
			]
		},
		{
			"label": "git-commit-release",
			"type": "shell",
			"command": "git",
			"args": [
				"commit",
				"-m",
				"Fix car selection/spawn pipeline and add macOS app build"
			]
		},
		{
			"label": "git-log-last",
			"type": "shell",
			"command": "git",
			"args": [
				"log",
				"-1",
				"--oneline"
			]
		},
		{
			"label": "git-ls-remote-head",
			"type": "shell",
			"command": "git",
			"args": [
				"ls-remote",
				"--heads",
				"origin",
				"recovered-work"
			]
		},
		{
			"label": "git-push-origin",
			"type": "shell",
			"command": "git",
			"args": [
				"push",
				"origin",
				"recovered-work"
			]
		},
		{
			"label": "git-push-new-branch",
			"type": "shell",
			"command": "git",
			"args": [
				"push",
				"origin",
				"HEAD:recovered-work-app"
			]
		},
		{
			"label": "git-log-3",
			"type": "shell",
			"command": "git",
			"args": [
				"log",
				"-3",
				"--oneline",
				"--decorate"
			]
		},
		{
			"label": "git-main-check",
			"type": "shell",
			"command": "sh",
			"args": [
				"-lc",
				"git status -sb; echo '---'; git branch -vv; echo '---'; git rev-parse --short HEAD; git rev-parse --short main; git rev-parse --short recovered-work; echo '---'; git log --oneline --decorate -8 --graph --all"
			]
		},
		{
			"label": "git-branch-vv-nopager",
			"type": "shell",
			"command": "env",
			"args": [
				"GIT_PAGER=cat",
				"git",
				"branch",
				"-vv"
			]
		},
		{
			"label": "git-divergence-count",
			"type": "shell",
			"command": "env",
			"args": [
				"GIT_PAGER=cat",
				"git",
				"rev-list",
				"--left-right",
				"--count",
				"main...recovered-work"
			]
		},
		{
			"label": "git-heads-short",
			"type": "shell",
			"command": "sh",
			"args": [
				"-lc",
				"echo main=$(git rev-parse --short main); echo recovered-work=$(git rev-parse --short recovered-work); echo origin/main=$(git rev-parse --short origin/main); echo origin/recovered-work=$(git rev-parse --short origin/recovered-work)"
			]
		},
		{
			"label": "git-current-branch",
			"type": "shell",
			"command": "git",
			"args": [
				"branch",
				"--show-current"
			]
		},
		{
			"label": "git-main-head-check",
			"type": "shell",
			"command": "sh",
			"args": [
				"-lc",
				"echo main=$(git rev-parse --short main); echo recovered-work=$(git rev-parse --short recovered-work); echo origin/main=$(git rev-parse --short origin/main)"
			]
		},
		{
			"label": "git-divergence-main",
			"type": "shell",
			"command": "git",
			"args": [
				"rev-list",
				"--left-right",
				"--count",
				"main...recovered-work"
			]
		},
		{
			"label": "git-checkout-main",
			"type": "shell",
			"command": "git",
			"args": [
				"checkout",
				"main"
			]
		},
		{
			"label": "git-merge-ff-main",
			"type": "shell",
			"command": "git",
			"args": [
				"merge",
				"--ff-only",
				"recovered-work"
			]
		},
		{
			"label": "git-push-main",
			"type": "shell",
			"command": "git",
			"args": [
				"push",
				"origin",
				"main"
			]
		},
		{
			"label": "git-add-vscode-task",
			"type": "shell",
			"command": "git",
			"args": [
				"add",
				".vscode/tasks.json"
			]
		},
		{
			"label": "git-commit-vscode-task",
			"type": "shell",
			"command": "git",
			"args": [
				"commit",
				"-m",
				"Update VS Code task definitions"
			]
		},
		{
			"label": "git-fetch-origin",
			"type": "shell",
			"command": "git",
			"args": [
				"fetch",
				"origin"
			]
		},
		{
			"label": "git-divergence-rw-origin-main",
			"type": "shell",
			"command": "git",
			"args": [
				"rev-list",
				"--left-right",
				"--count",
				"origin/main...recovered-work"
			]
		},
		{
			"label": "git-merge-origin-main-into-rw",
			"type": "shell",
			"command": "git",
			"args": [
				"merge",
				"origin/main"
			]
		},
		{
			"label": "git-push-rw",
			"type": "shell",
			"command": "git",
			"args": [
				"push",
				"origin",
				"recovered-work"
			]
		},
		{
			"label": "git-push-rw-to-main",
			"type": "shell",
			"command": "git",
			"args": [
				"push",
				"origin",
				"recovered-work:main"
			]
		},
		{
			"label": "git-status-short-check",
			"type": "shell",
			"command": "git",
			"args": [
				"status",
				"-sb"
			]
		},
		{
			"label": "git-divergence-main-rw-again",
			"type": "shell",
			"command": "git",
			"args": [
				"rev-list",
				"--left-right",
				"--count",
				"origin/main...recovered-work"
			]
		},
		{
			"label": "git-log-graph-short",
			"type": "shell",
			"command": "sh",
			"args": [
				"-lc",
				"env GIT_PAGER=cat git log --oneline --decorate --graph -8 --all"
			]
		},
		{
			"label": "git-status-after-merge",
			"type": "shell",
			"command": "git",
			"args": [
				"status",
				"-sb"
			]
		},
		{
			"label": "git-divergence-after-merge",
			"type": "shell",
			"command": "git",
			"args": [
				"rev-list",
				"--left-right",
				"--count",
				"origin/main...recovered-work"
			]
		},
		{
			"label": "git-heads-after-merge",
			"type": "shell",
			"command": "sh",
			"args": [
				"-lc",
				"echo rw=$(git rev-parse --short recovered-work); echo omain=$(git rev-parse --short origin/main); echo lmain=$(git rev-parse --short main)"
			]
		},
		{
			"label": "git-fastforward-local-main-ref",
			"type": "shell",
			"command": "git",
			"args": [
				"branch",
				"-f",
				"main",
				"recovered-work"
			]
		},
		{
			"label": "git-final-main-verify",
			"type": "shell",
			"command": "sh",
			"args": [
				"-lc",
				"echo current=$(git branch --show-current); echo local_main=$(git rev-parse --short main); echo remote_main=$(git rev-parse --short origin/main); echo recovered_work=$(git rev-parse --short recovered-work); git rev-list --left-right --count main...origin/main; git status -sb"
			]
		}
	]
}